{
  "name": "@mongez/reinforcements",
  "version": "4.0.2",
  "description": "A lightweight package to give a massive reinforcements to variant types of data in Nodejs/Javascript",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hassanzohdy/reinforcements"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "array",
    "object",
    "string",
    "number",
    "async",
    "promise",
    "lodash",
    "lazy",
    "debounce",
    "throttle",
    "memoize",
    "pipe",
    "compose",
    "clone",
    "merge",
    "flatten",
    "slugify",
    "typescript"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0"
}
